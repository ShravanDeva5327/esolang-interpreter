fib_n_2 = 0
fib_n_1 = 1

for n = 0 to 10 do
    if n == 0 then
        print("Fibonacci number ", n, " is ", 0)
    else
        if n == 1 then
            print("Fibonacci number ", n, " is ", 1)
        else
            fib_n = fib_n_1 + fib_n_2
            fib_n_2 = fib_n_1
            fib_n_1 = fib_n
            print("Fibonacci number ", n, " is ", fib_n)
        end
    end
end